{
  "name": "@telestream/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node host for the TeleStream API (runs on your VPS next to telegram-service). SQLite database, background sync, HTTP server.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@telestream/shared": "*",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0"
  }
}
